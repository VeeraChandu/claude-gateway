{
  "name": "claude-gateway",
  "version": "2.1.0",
  "description": "Low-latency, zero-dependency gateway that runs Claude Code against OpenAI or any OpenAI-compatible provider",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-timeout=20000",
    "test:live": "node scripts/smoke-live.js",
    "bench": "node bench/overhead.js"
  },
  "keywords": [
    "claude-code",
    "openai",
    "llm-gateway",
    "proxy"
  ],
  "author": "Veera Chandu",
  "license": "MIT"
}
