# ── Upstream provider (any OpenAI-compatible /chat/completions API) ──────────
#   OpenAI:    https://api.openai.com/v1
#   Venice:    https://api.venice.ai/api/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Groq:      https://api.groq.com/openai/v1
#   Ollama:    http://localhost:11434/v1   (any non-empty key, e.g. "ollama")
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key-here
# OPENAI_* values here override your shell (other settings: shell wins).
# ${VAR} expands from the shell, e.g.:
# OPENAI_API_KEY=${VENICE_API_TOKEN}

# ── Models ───────────────────────────────────────────────────────────────────
# Claude model names are routed by family; anything else falls back to DEFAULT_MODEL.
# Non-Claude names (claude --model gpt-4.1) pass through unchanged.
DEFAULT_MODEL=gpt-4o
MODEL_OPUS=gpt-4o
MODEL_SONNET=gpt-4o
MODEL_HAIKU=gpt-4o-mini
# Exact or prefix overrides, longest prefix wins:
# MODEL_MAP={"claude-sonnet-4-5":"gpt-4.1","claude-fable":"o3"}

# Cap Claude Code's large max_tokens to what the upstream model accepts (gpt-4o: 16384).
MAX_OUTPUT_TOKENS=16384

# Regex for models that need max_completion_tokens and no temperature.
# Default matches o1/o3/o4*, gpt-5*, *reasoner*.
# REASONING_MODELS=^(o\d|gpt-5)|reasoner

# ── Server & security ────────────────────────────────────────────────────────
PORT=8080
HOST=127.0.0.1
# Shared secret clients must send as ANTHROPIC_API_KEY. Required when HOST is not
# loopback, and by docker compose. Generate with: openssl rand -hex 24
GATEWAY_API_KEY=
# Forward each client's own key upstream instead of OPENAI_API_KEY:
# PASSTHROUGH_CLIENT_KEY=true
# Docker host port (container always listens on 8080):
# DOCKER_PORT=5175

# ── Tuning (defaults shown) ──────────────────────────────────────────────────
# UPSTREAM_TIMEOUT_MS=300000      # wait for response headers
# STREAM_IDLE_TIMEOUT_MS=300000   # max gap between streamed chunks
# UPSTREAM_MAX_RETRIES=2          # 408/429/5xx/network, before streaming starts
# MAX_BODY_MB=32
# LOG_FORMAT=pretty               # pretty on a TTY, json otherwise
# LOG_LEVEL=info
