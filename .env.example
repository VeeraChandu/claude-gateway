# Server Port and Host
PORT=8080
HOST=127.0.0.1

# OpenAI or OpenAI-Compatible Provider Settings
# For official OpenAI: https://api.openai.com/v1
# For Venice AI:       https://api.venice.ai/api/v1
# For DeepSeek:        https://api.deepseek.com/v1
# For Groq:            https://api.groq.com/openai/v1
# For Ollama:          http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key-here

# Default model to route requests to
DEFAULT_MODEL=gpt-4o

# Specific model mappings (optional)
MODEL_SONNET=gpt-4o
MODEL_HAIKU=gpt-4o-mini
MODEL_OPUS=gpt-4o
