# Connections, routes and client keys are managed in the admin UI at /admin and
# stored in data/gateway.json. The provider settings below only SEED that store
# the first time the gateway starts; after that, edit them in the UI.

# ── First-run seed (optional) ────────────────────────────────────────────────
#   OpenAI:    https://api.openai.com/v1
#   Venice:    https://api.venice.ai/api/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Ollama:    http://localhost:11434/v1   (any non-empty key, e.g. "ollama")
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key-here
# ${VAR} expands from your shell, e.g. OPENAI_API_KEY=${VENICE_API_TOKEN}
DEFAULT_MODEL=gpt-4o
# MODEL_OPUS=gpt-4o
# MODEL_SONNET=gpt-4o
# MODEL_HAIKU=gpt-4o-mini
# MODEL_MAP={"claude-sonnet-4-5":"gpt-4.1"}
# MAX_OUTPUT_TOKENS=16384
# REASONING_MODELS=^(o\d|gpt-5)|reasoner
# Auth scheme, query string and the rejected-parameter retry are per connection in
# the admin UI. Azure OpenAI, for instance, needs a custom "api-key" header and
# ?api-version=… — pick the Azure OpenAI preset when adding a connection.
# Becomes the first client key (named "from GATEWAY_API_KEY"):
# GATEWAY_API_KEY=
# Sets the admin password instead of using the one-time setup code:
# ADMIN_PASSWORD=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
HOST=127.0.0.1
# DATA_DIR=./data                 # where gateway.json lives ("none" = in memory)

# ── Admin UI ─────────────────────────────────────────────────────────────────
# ADMIN_ENABLED=true
# ADMIN_ALLOW_FROM=local          # local = loopback, private LAN/Docker, Tailscale; or "any"
# ADMIN_HOSTS=gateway.home.lan    # extra Host names (IPs, *.ts.net, single-label names always allowed)
# ALLOW_UNAUTHENTICATED=false     # serve /v1 without client keys on a non-loopback HOST

# ── Docker (compose) ─────────────────────────────────────────────────────────
# DOCKER_BIND=127.0.0.1           # host address to publish on (e.g. your Tailscale IP)
# DOCKER_PORT=5175

# ── Tuning (defaults shown) ──────────────────────────────────────────────────
# UPSTREAM_TIMEOUT_MS=300000
# STREAM_IDLE_TIMEOUT_MS=300000
# UPSTREAM_MAX_RETRIES=2
# MAX_BODY_MB=32
# LOG_FORMAT=pretty               # pretty on a TTY, json otherwise
# LOG_LEVEL=info
